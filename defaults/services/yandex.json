{
  "name": "YandexAI",
  "config_key": "YANDEX_API_KEY",
  "config_key2": "YANDEX_FOLDER_ID",
  "key_label": "IAM Token (Bearer)",
  "key2_label": "Folder ID",
  "base_url": "https://ai.api.cloud.yandex.net/v1",
  "auth_type": "yandex_iam",
  "require_folder_id": true,
  "temp_min": 0.0,
  "temp_max": 1.0,
  "temp_default": 0.3,
  "temp_step": 0.05,
  "context_window_default": 32000,
  "max_tokens_default": 32000,
  "tools_options": [
    {
      "key": "web_search",
      "label": {
        "ru": "Веб-поиск",
        "en": "Web search"
      }
    }
  ],
  "extra_fields": [
    {
      "key": "reasoning_effort",
      "label": {
        "en": "Reasoning effort",
        "ru": "Уровень рассуждений"
      },
      "type": "select",
      "options": [
        "",
        "none",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ],
      "default": "",
      "tooltip": {
        "en": "Responses API reasoning.effort: empty = model default; none disables thinking, minimal…xhigh enable it with increasing depth",
        "ru": "Responses API reasoning.effort: пусто = значение модели по умолчанию; none выключает рассуждения, minimal…xhigh включают их с разной глубиной"
      }
    },
    {
      "key": "web_search_context_size",
      "label": {
        "en": "Web search context size",
        "ru": "Объём контекста веб-поиска"
      },
      "type": "select",
      "options": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "tooltip": {
        "en": "How much context the web_search tool may use: low, medium or high",
        "ru": "Сколько контекстного окна может использовать инструмент веб-поиска: low, medium или high"
      }
    },
    {
      "key": "web_search_allowed_domains",
      "label": {
        "en": "Web search allowed domains",
        "ru": "Разрешённые домены веб-поиска"
      },
      "type": "text",
      "default": "",
      "tooltip": {
        "en": "Optional comma/space separated list of domains the web_search tool is restricted to (e.g. docs.python.org, developer.mozilla.org). Leave empty for unrestricted search",
        "ru": "Необязательный список доменов через запятую/пробел, которыми ограничен веб-поиск (например, docs.python.org, developer.mozilla.org). Оставьте пустым для поиска без ограничений"
      }
    }
  ],
